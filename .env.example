# Copy to purple_agent/.env and fill in. Never commit the real file.

# --- Model ------------------------------------------------------------------
# A PURPLE_MODEL beginning with "openrouter/" is routed through LiteLLM.
OPENROUTER_API_KEY=your-openrouter-key
PURPLE_MODEL=openrouter/z-ai/glm-4.7-flash
PURPLE_MAX_TOKENS=16384
# Low by default: this agent reports whether detections fired, and creative
# variance in that verdict is a defect.
PURPLE_TEMPERATURE=0.2

# Alternative A -- Vertex AI, sharing the same ADC credential as SecOps (no API
# key to manage). Requires the API to be enabled on the project first:
#   gcloud services enable aiplatform.googleapis.com --project=YOUR_PROJECT
#   GOOGLE_GENAI_USE_VERTEXAI=TRUE
#   GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1
#   PURPLE_MODEL=gemini-2.5-flash
#
# Alternative B -- AI Studio:
#   GOOGLE_GENAI_USE_VERTEXAI=FALSE
#   GOOGLE_API_KEY=your-ai-studio-key
#   PURPLE_MODEL=gemini-2.5-flash

# --- Google SecOps (Chronicle) tenant ---------------------------------------
# Substitute your own region, project and instance. The MCP endpoint hostname
# follows the pattern chronicle.<REGION>.rep.googleapis.com/mcp.
SECOPS_MCP_URL=https://chronicle.<REGION>.rep.googleapis.com/mcp
SECOPS_PROJECT_ID=your-gcp-project-id
SECOPS_CUSTOMER_ID=00000000-0000-0000-0000-000000000000
SECOPS_REGION=us

# Required by import_logs. No tool lists forwarders -- discover one with
#   python scripts/find_forwarder.py
SECOPS_FORWARDER_ID=00000000-0000-0000-0000-000000000000

# --- Synthetic data marking -------------------------------------------------
# import_logs accepts no labels, so generated events are marked in-band by
# hostname. Everything this agent creates is findable (and excludable) with
#   principal.hostname = /^PT-LAB-/
PURPLE_HOST_PREFIX=PT-LAB-

# Run Stage A with no SecOps tenant at all -- the agent still needs a model
# (it is an agent), but every Chronicle request is refused at the transport, so
# generation and the oracle work while ingest and verification are impossible
# rather than merely unconfigured. Off by default; opt in per-run with
#   PURPLE_OFFLINE=1 adk run purple_agent
PURPLE_OFFLINE=

# Where each Stage A run writes its folder. Each run produces
# <run_id>/<LOG_TYPE>.xml (raw newline-delimited events, replayable and
# re-ingestable), plus events.json and manifest.json. Relative paths resolve
# against the project root; an absolute path works too.
PURPLE_OUT_DIR=out

# --- Sigma corpus -----------------------------------------------------------
SIGMA_REPO_DIR=vendor/sigma
SIGMA_INDEX_DIR=data

# Domain and account used inside generated events. Set to match the environment
# under test so the telemetry looks native.
PURPLE_DNS_DOMAIN=corp.local
PURPLE_NETBIOS_DOMAIN=CORP
PURPLE_ACTOR_USER=svc_backup
